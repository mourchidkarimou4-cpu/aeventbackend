# ═══════════════════════════════════════════════════════════════════
# Backend Django Configuration
# Copier ce fichier en .env et remplir avec vos vraies valeurs
# ⚠️ IMPORTANT: JAMAIS commiter le fichier .env réel en production !
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# DJANGO CORE
# ─────────────────────────────────────────────────────────────────
DEBUG=False
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production-please
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ─────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────────────────────────
# Option 1: DATABASE_URL (Recommended for production/render.com)
DATABASE_URL=postgresql://user:password@localhost:5432/aevents_db

# Option 2: Individual DB settings (Development)
DB_NAME=aevents_db
DB_USER=aevents_user
DB_PASSWORD=very_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────────────────────────────────
# ADMIN ACCOUNT (create_admin command)
# ─────────────────────────────────────────────────────────────────
# Si ADMIN_INITIAL_PASSWORD est absent, un mot de passe aléatoire est
# généré et affiché une seule fois dans les logs.
ADMIN_INITIAL_PASSWORD=change-me-now
ADMIN_EMAIL=admin@ams.bj
ADMIN_USERNAME=admin

# Token secret pour l'endpoint POST /api/core/reset-admin-password/
# (optionnel — si absent, l'endpoint répond 503 et reste désactivé)
ADMIN_RESET_TOKEN=generate-a-long-random-token

# ─────────────────────────────────────────────────────────────────
# CLOUDINARY (Image Storage) — OPTIONNEL
# Get these from https://cloudinary.com/console
# ─────────────────────────────────────────────────────────────────
# Si ces 3 valeurs sont vides ou absentes, le site fonctionne quand même :
# les fichiers uploadés sont stockés localement (MEDIA_ROOT, dossier /media),
# servis par Django en dev et par nginx en production.
# ⚠️ Sur Render, le disque est éphémère : pour persister les images en
# production, renseignez ces valeurs (Cloudinary). Sinon, elles sont perdues
# à chaque redéploiement.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────────────────────────
# CORS & Security
# ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# ====================================
# Optional Settings
# ====================================
# ─ Email (OPTIONNEL) ─
# Dès que EMAIL_HOST est renseigné, Django envoie via SMTP ; sinon les emails
# sont affichés dans les logs (backend console) — rien à configurer pour que
# le site fonctionne.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=AMS <no-reply@ams.bj>
